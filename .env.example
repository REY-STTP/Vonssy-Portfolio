NEXT_PUBLIC_SITE_URL=https://your-deployed-domain.example

# Required for the RAG chat assistant — OpenAI-compatible LLM router provider
LLM_API_KEY=xxxxx
LLM_BASE_URL=https://router.bynara.id/v1

# Embeddings provider (OpenAI-compatible /embeddings endpoint).
# Default targets Jina AI — free trial includes 10M tokens: https://jina.ai/
EMBEDDINGS_BASE_URL=https://api.jina.ai/v1
EMBEDDINGS_MODEL=jina-embeddings-v3
EMBEDDINGS_API_KEY=xxxxx          # or EMBEDDINGS_API_KEY
EMBEDDINGS_DIMENSIONS=1024  # Matryoshka size — smaller = smaller index file

GITHUB_TOKEN=xxxxx          # opsional tapi disarankan — naikkan rate limit GitHub API dari 60/jam ke 5000/jam, dipakai scripts/ingest.ts & GitHub Actions
